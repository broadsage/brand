---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AssetStudio from '../islands/AssetStudio';
import AppSubBrandStudio from '../islands/AppSubBrandStudio';
import ColorPaletteMatrix from '../islands/ColorPaletteMatrix';
import GovernanceRules from '../components/GovernanceRules.astro';
import ClearspaceGuide from '../components/ClearspaceGuide.astro';
import VoiceToneGuide from '../components/VoiceToneGuide.astro';
import TypographySpecimens from '../components/TypographySpecimens.astro';
import Narrative from '../components/Narrative.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-16 sm:space-y-24 w-full flex-1">
    {/* 1. Hero Section */}
    <Hero />

    {/* 2. Official Marks & Brand Assets (Asset-First) */}
    <section id="emblems" class="space-y-8 scroll-mt-24">
      <SectionHeader
        title="Official Production Marks"
        subtitle="Master vector emblems, OS app launchers, circular avatars, and horizontal wordmarks pre-optimized across native dark and light grounds"
        badge="Official Marks"
      />

      <AssetStudio client:visible />

      {/* Enterprise Application Sub-Brand Lockup Studio */}
      <AppSubBrandStudio client:visible />
    </section>

    {/* 3. Official Color System & Copyable Code Tokens */}
    <section id="colors" class="space-y-8 scroll-mt-24">
      <SectionHeader
        title="Official Color System & Code Tokens"
        subtitle="Copyable Tailwind v4 (@theme), Tailwind v3, CSS variables, and JSON design tokens with WCAG AAA verification"
        badge="Color Palette"
      />

      <ColorPaletteMatrix client:visible />
    </section>

    {/* 4. Brand Governance, Clearspace & Voice (Consolidated Standards) */}
    <div class="space-y-16 sm:space-y-24">
      {/* Brand Governance & Visual Do's & Don'ts */}
      <GovernanceRules />

      {/* Clearspace & Minimum Dimensions */}
      <ClearspaceGuide />

      {/* Voice & Tone Guidelines */}
      <VoiceToneGuide />

      {/* Typography Hierarchy & Specimen */}
      <TypographySpecimens />
    </div>

    {/* 5. Brand Foundation, Mission & Press Kit */}
    <Narrative />
  </main>

  <Footer />
</BaseLayout>
