---
import OllieMascot from '../islands/OllieMascot';
---

<section class="glass-panel p-6 sm:p-10 lg:p-12 rounded-3xl border border-amber-500/25 bg-gradient-to-br from-slate-900/90 via-[#0A1128]/95 to-slate-950/90 shadow-2xl relative overflow-hidden">
  {/* Ambient Background Radial Glow */}
  <div class="absolute -top-32 -right-32 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none" />
  <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none" />

  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    {/* Left Column: Hero Copy & Meta */}
    <div class="lg:col-span-8 space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800/80 border border-slate-700/80 text-xs font-semibold text-amber-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
        Developer Platform Engineering (DPE) • Brand Architecture
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.15]">
        Broadsage Brand Identity &amp; System Guidelines
      </h1>

      <p class="text-base sm:text-xl font-semibold text-amber-400/95 leading-snug">
        “Broad Vision, Sage Guidance — Open to Everyone”
      </p>

      <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl">
        The definitive design manual and master brand standards for Broadsage. Engineered as a unified Developer Platform Engineering (DPE) initiative bridging open-source innovation with hardened enterprise technology solutions under a singular, cohesive identity.
      </p>

      {/* Hero Meta Information Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-slate-800/80">
        <div class="space-y-1">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block">
            Official Mascot
          </span>
          <span class="text-sm font-semibold text-white">Ollie the Sage Owl</span>
        </div>
        <div class="space-y-1">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block">
            Brand Architecture
          </span>
          <span class="text-sm font-semibold text-white">DPE Platform Initiative</span>
        </div>
        <div class="space-y-1">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block">
            Design Authority
          </span>
          <span class="text-sm font-semibold text-white">Broadsage</span>
        </div>
      </div>

      {/* Quick CTAs */}
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="#emblems"
          class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/25 transition-all hover:-translate-y-0.5"
        >
          Explore Vector Marks
        </a>
        <a
          href="#colors"
          class="px-5 py-2.5 rounded-xl bg-slate-800/90 hover:bg-slate-800 text-slate-200 font-semibold text-sm border border-slate-700 transition-all hover:border-amber-500/40"
        >
          Design Tokens &amp; Palette
        </a>
      </div>
    </div>

    {/* Right Column: Hero Master Mascot Emblem */}
    <div class="lg:col-span-4 flex flex-col items-center justify-center">
      <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-b from-[#0A1128] to-[#050814] border border-amber-500/30 shadow-2xl relative group">
        <div class="w-48 h-48 sm:w-56 sm:h-56 drop-shadow-[0_20px_35px_rgba(245,158,11,0.2)] group-hover:scale-105 transition-transform duration-500">
          <OllieMascot variant="primary" size="100%" client:load />
        </div>
        <div class="text-center mt-4">
          <span class="text-xs font-mono font-bold text-amber-400">
            Ollie — The Sage Guidance Beacon
          </span>
          <span class="text-[11px] text-slate-500 block mt-0.5">Master Vector SVG (200×200)</span>
        </div>
      </div>
    </div>
  </div>
</section>

