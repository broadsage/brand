---
interface Props {
  title: string;
  subtitle: string;
  badge: string;
  badgeClass?: string;
  class?: string;
}

const {
  title,
  subtitle,
  badge,
  badgeClass = 'dark:bg-slate-800 bg-[#FAF8F5] text-amber-500 dark:text-amber-400 border dark:border-slate-700 border-[#DBD1C2]',
  class: className = '',
} = Astro.props;
---

<div class={`flex items-end justify-between border-b dark:border-slate-800/80 border-[#E6DED2] pb-4 flex-wrap gap-3 ${className}`}>
  <div class="space-y-1">
    <h2 class="text-2xl sm:text-3xl font-extrabold dark:text-white text-[#0A1128] tracking-tight">
      {title}
    </h2>
    <p class="text-xs sm:text-sm dark:text-slate-400 text-slate-600">
      {subtitle}
    </p>
  </div>
  <span class={`text-xs font-mono font-bold px-2.5 py-1 rounded-md border shadow-2xs ${badgeClass}`}>
    {badge}
  </span>
</div>

