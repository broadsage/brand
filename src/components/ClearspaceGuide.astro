---
import OllieMascot from '../islands/OllieMascot';
---

<section id="clearspace" class="space-y-8 scroll-mt-24">
  {/* Section Header */}
  <div class="flex items-end justify-between border-b border-slate-800 pb-4 flex-wrap gap-2">
    <div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        Clearspace &amp; Minimum Dimensions
      </h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        Mathematical exclusion zone and minimum rendering thresholds
      </p>
    </div>
    <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-md bg-slate-800 text-amber-400 border border-slate-700">
      Precision Layout
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    {/* Left: Responsive Clearspace Diagram */}
    <div class="lg:col-span-6 glass-panel p-8 sm:p-12 rounded-2xl border border-slate-800 flex items-center justify-center bg-[#050814]/90">
      <div class="relative p-8 sm:p-10 border-2 border-dashed border-amber-500/70 rounded-3xl bg-amber-500/[0.03] flex items-center justify-center">
        {/* Top Marker */}
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded bg-[#0A1128] border border-amber-500 text-[10px] font-mono font-bold text-amber-400 whitespace-nowrap shadow-md">
          X = 0.25 H
        </div>

        {/* Bottom Marker */}
        <div class="absolute -bottom-3.5 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded bg-[#0A1128] border border-amber-500 text-[10px] font-mono font-bold text-amber-400 whitespace-nowrap shadow-md">
          X = 0.25 H
        </div>

        {/* Left Marker */}
        <div class="absolute top-1/2 -left-3.5 -translate-y-1/2 px-1.5 py-0.5 rounded bg-[#0A1128] border border-amber-500 text-[10px] font-mono font-bold text-amber-400 shadow-md">
          X
        </div>

        {/* Right Marker */}
        <div class="absolute top-1/2 -right-3.5 -translate-y-1/2 px-1.5 py-0.5 rounded bg-[#0A1128] border border-amber-500 text-[10px] font-mono font-bold text-amber-400 shadow-md">
          X
        </div>

        {/* Central Mascot Subject */}
        <div class="w-32 h-32 sm:w-40 sm:h-40 drop-shadow-xl">
          <OllieMascot variant="primary" size="100%" client:load />
        </div>
      </div>
    </div>

    {/* Right: Technical Clearspace Rule Copy */}
    <div class="lg:col-span-6 glass-panel p-6 sm:p-8 rounded-2xl border border-slate-800 space-y-5">
      <div>
        <h3 class="text-lg font-bold text-amber-400">The "X" Clearspace Rule</h3>
        <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
          The exclusion zone guarantees that Ollie is never crowded by text, borders, or neighboring UI elements. The unit <strong class="text-white">X</strong> is defined mathematically as <strong class="text-white">1/4th of the mascot height (or the exact height of Ollie's eyeglass frame)</strong>.
        </p>
      </div>

      <div class="space-y-3 pt-3 border-t border-slate-800">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">
          Minimum Rendering Thresholds
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800 space-y-1">
            <span class="text-amber-400 font-semibold block">Digital Minimum (Emblem)</span>
            <span class="font-mono text-white text-sm font-bold">32px × 32px</span>
            <span class="text-[11px] text-slate-500 block">Favicon, browser tabs, app tray</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800 space-y-1">
            <span class="text-amber-400 font-semibold block">Digital Minimum (Wordmark)</span>
            <span class="font-mono text-white text-sm font-bold">140px × 32px</span>
            <span class="text-[11px] text-slate-500 block">Mobile nav headers, footers</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800 space-y-1">
            <span class="text-sky-400 font-semibold block">Print Minimum (Emblem)</span>
            <span class="font-mono text-white text-sm font-bold">12mm × 12mm</span>
            <span class="text-[11px] text-slate-500 block">Conference badges, stickers</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800 space-y-1">
            <span class="text-sky-400 font-semibold block">Print Minimum (Wordmark)</span>
            <span class="font-mono text-white text-sm font-bold">35mm Width</span>
            <span class="text-[11px] text-slate-500 block">Stationery, apparel, swag</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

