---
import OllieMascot from '../islands/OllieMascot';
import SectionHeader from './SectionHeader.astro';
---

<section id="clearspace" class="space-y-5 scroll-mt-24">
  <SectionHeader
    title="Clearspace & Minimum Dimensions"
    subtitle="Mathematical exclusion zone and minimum rendering thresholds"
    badge="Precision Layout"
  />

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-5 items-stretch">
    {/* Left: Responsive Clearspace Diagram */}
    <div class="lg:col-span-6 glass-panel p-5 sm:p-6 rounded-xl border dark:border-slate-800/80 border-[#E6DED2] flex items-center justify-center dark:bg-[#050814]/90 bg-white shadow-md">
      <div class="relative p-5 sm:p-6 border-2 border-dashed border-amber-500/70 rounded-2xl bg-amber-500/[0.03] flex items-center justify-center">
        {/* Top Marker */}
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded dark:bg-[#0A1128] bg-white border border-amber-500 text-[9px] font-mono font-bold text-amber-500 dark:text-amber-400 whitespace-nowrap shadow-xs">
          X = 0.25 H
        </div>

        {/* Bottom Marker */}
        <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded dark:bg-[#0A1128] bg-white border border-amber-500 text-[9px] font-mono font-bold text-amber-500 dark:text-amber-400 whitespace-nowrap shadow-xs">
          X = 0.25 H
        </div>

        {/* Left Marker */}
        <div class="absolute top-1/2 -left-3 -translate-y-1/2 px-1.5 py-0.5 rounded dark:bg-[#0A1128] bg-white border border-amber-500 text-[9px] font-mono font-bold text-amber-500 dark:text-amber-400 shadow-xs">
          X
        </div>

        {/* Right Marker */}
        <div class="absolute top-1/2 -right-3 -translate-y-1/2 px-1.5 py-0.5 rounded dark:bg-[#0A1128] bg-white border border-amber-500 text-[9px] font-mono font-bold text-amber-500 dark:text-amber-400 shadow-xs">
          X
        </div>

        {/* Central Mascot Subject */}
        <div class="w-28 h-28 sm:w-32 sm:h-32 drop-shadow-lg">
          <OllieMascot variant="primary" size="100%" client:load />
        </div>
      </div>
    </div>

    {/* Right: Technical Clearspace Rule Copy & Thresholds */}
    <div class="lg:col-span-6 glass-panel p-4 sm:p-5 rounded-xl border dark:border-slate-800/80 border-[#E6DED2] space-y-4 flex flex-col justify-between">
      <div>
        <h3 class="text-base sm:text-lg font-bold text-amber-500 dark:text-amber-400">The "X" Clearspace Rule</h3>
        <p class="text-xs sm:text-sm text-slate-300 mt-1.5 leading-relaxed">
          The exclusion zone guarantees that Ollie is never crowded by text, borders, or neighboring UI elements. The unit <strong class="dark:text-white text-[#0A1128]">X</strong> is defined mathematically as <strong class="dark:text-white text-[#0A1128]">1/4th of the mascot height (or the exact height of Ollie's eyeglass frame)</strong>.
        </p>
      </div>

      <div class="space-y-2.5 pt-3 border-t dark:border-slate-800/80 border-[#E6DED2]">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">
          Minimum Rendering Thresholds
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
          <div class="p-2.5 rounded-lg dark:bg-slate-900/60 bg-[#FAF8F5] border dark:border-slate-800/80 border-[#DBD1C2] space-y-0.5 shadow-2xs">
            <span class="text-amber-500 dark:text-amber-400 font-semibold block text-[10px]">Digital Minimum (Emblem)</span>
            <span class="font-mono dark:text-white text-[#0A1128] text-xs font-bold">32px × 32px</span>
            <span class="text-[10px] text-slate-500 block">Favicon, browser tabs, app tray</span>
          </div>
          <div class="p-2.5 rounded-lg dark:bg-slate-900/60 bg-[#FAF8F5] border dark:border-slate-800/80 border-[#DBD1C2] space-y-0.5 shadow-2xs">
            <span class="text-amber-500 dark:text-amber-400 font-semibold block text-[10px]">Digital Minimum (Wordmark)</span>
            <span class="font-mono dark:text-white text-[#0A1128] text-xs font-bold">140px × 32px</span>
            <span class="text-[10px] text-slate-500 block">Mobile nav headers, footers</span>
          </div>
          <div class="p-2.5 rounded-lg dark:bg-slate-900/60 bg-[#FAF8F5] border dark:border-slate-800/80 border-[#DBD1C2] space-y-0.5 shadow-2xs">
            <span class="text-sky-500 dark:text-sky-400 font-semibold block text-[10px]">Print Minimum (Emblem)</span>
            <span class="font-mono dark:text-white text-[#0A1128] text-xs font-bold">12mm × 12mm</span>
            <span class="text-[10px] text-slate-500 block">Conference badges, stickers</span>
          </div>
          <div class="p-2.5 rounded-lg dark:bg-slate-900/60 bg-[#FAF8F5] border dark:border-slate-800/80 border-[#DBD1C2] space-y-0.5 shadow-2xs">
            <span class="text-sky-500 dark:text-sky-400 font-semibold block text-[10px]">Print Minimum (Wordmark)</span>
            <span class="font-mono dark:text-white text-[#0A1128] text-xs font-bold">35mm Width</span>
            <span class="text-[10px] text-slate-500 block">Stationery, apparel, swag</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

