---
import { Type, Terminal, Sparkles } from 'lucide-react';

const specimens = [
  {
    role: 'Master Wordmark',
    weight: 'ExtraBold (800)',
    size: '32px / 1.0',
    application: 'Corporate brandmark, header navigation, README title',
    previewType: 'wordmark',
  },
  {
    role: 'Display & Section Headings (H1/H2)',
    weight: 'Bold to ExtraBold (700-800)',
    size: '24px - 40px / 1.2',
    application: 'Landing declarations, feature headings, slide decks',
    previewText: 'Developer Platform Engineering & Agentic Mesh',
    previewClass: 'text-lg sm:text-xl font-bold text-white tracking-tight',
  },
  {
    role: 'Body Copy & Documentation',
    weight: 'Regular (400)',
    size: '14px - 15px / 1.6',
    application: 'Architectural whitepapers, guides, articles, release notes',
    previewText: 'Broadsage champions the open-source way by building transparent, community-driven technologies and transforming distributed stacks into hardened architectures.',
    previewClass: 'text-xs sm:text-sm text-slate-300 leading-relaxed',
  },
  {
    role: 'CLI, Code & Configuration',
    weight: 'Medium (500)',
    size: '12px - 13px / 1.5',
    application: 'Terminal output, design token configs, YAML schemas',
    previewType: 'code',
    previewText: '$ broadsage agent run --mesh kubernetes --cluster us-central1',
  },
];
---

<section id="typography" class="space-y-6 scroll-mt-24">
  {/* Section Header */}
  <div class="flex items-end justify-between border-b border-slate-800 pb-4 flex-wrap gap-2">
    <div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        Typography Hierarchy &amp; Specimen
      </h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        Engineered for high readability across IDEs, documentation, and executive keynotes
      </p>
    </div>
    <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-md bg-slate-800 text-amber-400 border border-slate-700">
      Type System
    </span>
  </div>

  {/* Font Stack Definitions Bar */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80 space-y-1">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-wider block">
          Primary UI &amp; Prose Stack (Geometric Sans)
        </span>
        <span class="text-[10px] font-mono text-slate-500">System Fallback</span>
      </div>
      <code class="text-xs font-mono text-slate-300 block break-all">
        -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif
      </code>
    </div>
    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80 space-y-1">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-wider block">
          Developer Code &amp; Terminal Stack (Precision Mono)
        </span>
        <span class="text-[10px] font-mono text-slate-500">Fixed Width</span>
      </div>
      <code class="text-xs font-mono text-slate-300 block break-all">
        ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace
      </code>
    </div>
  </div>

  {/* Compact Hierarchy Specimen Table */}
  <div class="glass-panel rounded-2xl border border-slate-800 overflow-hidden divide-y divide-slate-800/80">
    {specimens.map((item) => (
      <div class="p-4 sm:p-5 flex flex-col md:flex-row md:items-center justify-between gap-3 hover:bg-slate-900/40 transition-colors">
        <div class="w-full md:w-1/3 space-y-1">
          <div class="flex items-center gap-2">
            <span class="font-bold text-amber-400 text-xs sm:text-sm">{item.role}</span>
            <span class="text-slate-600">•</span>
            <span class="text-[11px] font-mono text-slate-400">{item.weight}</span>
          </div>
          <p class="text-[11px] text-slate-500">
            {item.application}
          </p>
        </div>

        <div class="w-full md:w-2/3 p-3 rounded-xl bg-[#050814]/80 border border-slate-900 flex items-center min-h-[48px] overflow-x-auto">
          {item.previewType === 'wordmark' ? (
            <div class="text-2xl font-black tracking-[-0.5px]">
              <span class="text-white">BROAD</span>
              <span class="text-amber-500">SAGE</span>
            </div>
          ) : item.previewType === 'code' ? (
            <div class="flex items-center gap-2 font-mono text-xs text-amber-300">
              <span class="text-slate-500 select-none">$</span>
              <span>broadsage agent run --mesh kubernetes --cluster us-central1</span>
            </div>
          ) : (
            <div class={item.previewClass}>
              {item.previewText}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

