---
import { Type, Terminal } from 'lucide-react';

const specimens = [
  {
    role: 'Wordmark Construction',
    weight: 'ExtraBold (800)',
    size: '34px / Line-height 1.0',
    tracking: '-0.5px tracking',
    application: 'Master corporate brandmark, top header, README title',
    previewType: 'wordmark',
  },
  {
    role: 'Display & Hero Statements',
    weight: 'ExtraBold (800)',
    size: '42px / Line-height 1.15',
    tracking: '-1.0px tracking',
    application: 'Major landing page declarations, keynote title slides',
    previewText: 'Developer Platform Engineering Solutions',
    previewClass: 'text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-tight',
  },
  {
    role: 'Section Headers (H2)',
    weight: 'Bold (700)',
    size: '24px / Line-height 1.3',
    tracking: '-0.5px tracking',
    application: 'Feature headings, card titles, chapter dividers',
    previewText: 'Agentic Observability & Distributed Telemetry Mesh',
    previewClass: 'text-lg sm:text-xl font-bold text-white tracking-tight',
  },
  {
    role: 'Body Copy (Prose)',
    weight: 'Regular (400)',
    size: '15px / Line-height 1.6',
    tracking: '0px tracking',
    application: 'Documentation guides, architectural whitepapers, articles',
    previewText: 'Broadsage champions the open-source way by building transparent, community-driven technologies and transforming distributed open-source stacks into hardened architectures.',
    previewClass: 'text-sm text-slate-300 leading-relaxed max-w-3xl',
  },
  {
    role: 'Terminal, Code & Configuration',
    weight: 'JetBrains Mono (500)',
    size: '13px / Line-height 1.5',
    tracking: '0px tracking',
    application: 'CLI output, design token configs, YAML schemas',
    previewType: 'code',
    previewText: '$ broadsage agent run --mesh kubernetes --cluster us-central1',
  },
];
---

<section id="typography" class="space-y-8 scroll-mt-24">
  {/* Section Header */}
  <div class="flex items-end justify-between border-b border-slate-800 pb-4 flex-wrap gap-2">
    <div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        Typography Hierarchy &amp; Specimen
      </h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        Engineered for high readability across IDEs, documentation, and executive keynotes
      </p>
    </div>
    <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-md bg-slate-800 text-amber-400 border border-slate-700">
      Type System
    </span>
  </div>

  {/* Font Stack Definitions Bar */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80 space-y-1">
      <span class="text-xs font-mono font-bold text-sky-400 uppercase tracking-wider block">
        Primary UI &amp; Prose Stack (Geometric Sans)
      </span>
      <code class="text-xs font-mono text-slate-300 block break-all">
        -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif
      </code>
    </div>
    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80 space-y-1">
      <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-wider block">
        Developer Code &amp; Terminal Stack (Precision Mono)
      </span>
      <code class="text-xs font-mono text-slate-300 block break-all">
        ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace
      </code>
    </div>
  </div>

  {/* Responsive Specimen Stack Cards */}
  <div class="space-y-4">
    {specimens.map((item) => (
      <div class="glass-panel p-5 sm:p-6 rounded-2xl border border-slate-800 hover:border-slate-700 transition-all space-y-3">
        <div class="flex items-center justify-between flex-wrap gap-2 text-xs">
          <div class="flex items-center gap-2">
            <span class="font-bold text-amber-400">{item.role}</span>
            <span class="text-slate-500">•</span>
            <span class="text-slate-300 font-medium">{item.weight}</span>
          </div>
          <div class="flex items-center gap-2 font-mono text-slate-400 text-[11px]">
            <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-800">{item.size}</span>
            <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-800">{item.tracking}</span>
          </div>
        </div>

        {/* Live Preview Stage */}
        <div class="p-4 rounded-xl bg-[#050814]/80 border border-slate-900 flex items-center min-h-[56px] overflow-x-auto">
          {item.previewType === 'wordmark' ? (
            <div class="text-2xl sm:text-3xl font-black tracking-[-0.5px]">
              <span class="text-white">BROAD</span>
              <span class="text-amber-500">SAGE</span>
            </div>
          ) : item.previewType === 'code' ? (
            <div class="flex items-center gap-2 font-mono text-xs text-amber-300">
              <span class="text-slate-500 select-none">$</span>
              <span>broadsage agent run --mesh kubernetes --cluster us-central1</span>
            </div>
          ) : (
            <div class={item.previewClass}>
              {item.previewText}
            </div>
          )}
        </div>

        <p class="text-[11px] text-slate-500">
          <strong class="text-slate-400">Application:</strong> {item.application}
        </p>
      </div>
    ))}
  </div>
</section>

