---

<footer class="mt-20 border-t border-slate-800 bg-[#050814] py-14 px-4 sm:px-8 text-center text-xs text-slate-500">
  <div class="max-w-7xl mx-auto space-y-6">
    <div class="flex items-center justify-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <p class="font-semibold text-slate-300">
        Broadsage Brand Identity &amp; System Guidelines • Version 1.0 (Officially Sealed)
      </p>
    </div>

    <p class="text-amber-400/90 font-medium italic">
      “Broad Vision, Sage Guidance — Open to Everyone”
    </p>

    {/* Digital Touchpoints (Website & Social Media) */}
    <div class="flex items-center justify-center gap-3 pt-2">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.title}
          title={link.title}
          class="w-10 h-10 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/50 flex items-center justify-center text-slate-400 hover:text-amber-400 hover:bg-slate-800/90 transition-all hover:scale-110 shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-500/40"
        >
          {link.type === 'globe' ? (
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <line x1="2" y1="12" x2="22" y2="12" />
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
          ) : (
            <svg class="w-4 h-4" viewBox={link.viewBox} fill="currentColor" aria-hidden="true">
              <path d={link.path} />
            </svg>
          )}
        </a>
      ))}
    </div>

    {/* Open Source Colophon & Gratitude Bar */}
    <div class="pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <p class="text-[11px] text-slate-500 order-2 sm:order-1">
        Copyright &copy; 2026 Broadsage. All rights reserved.
      </p>

      <div class="flex items-center gap-2 flex-wrap justify-center order-1 sm:order-2">
        <span class="text-[10px] font-mono uppercase tracking-wider text-slate-500 mr-0.5">
          ENGINEERED WITH OPEN SOURCE
        </span>

        {/* Astro Badge */}
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          title="Astro — Next-Gen Island Architecture Web Framework"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-orange-500/50 text-slate-400 hover:text-orange-400 hover:bg-orange-500/10 transition-all text-[11px] font-semibold group focus:outline-none focus:ring-2 focus:ring-orange-500/40 shadow-sm"
        >
          <svg class="w-3.5 h-3.5 transition-transform group-hover:scale-110" viewBox="0 0 85 107" fill="none" aria-hidden="true">
            <path fill="url(#astro-flame-footer)" d="M27.6 91.1c-4.8-4.4-6.3-13.7-4.2-20.4 3.5 4.2 8.3 5.6 13.3 6.3 7.7 1.2 15.3.8 22.5-2.8l2.5-1.4c.7 2 .9 3.9.6 5.9-.6 4.9-3 8.7-6.9 11.5-1.5 1.2-3.2 2.2-4.8 3.3-4.9 3.3-6.2 7.2-4.4 12.9l.2.6a13 13 0 0 1-5.7-5 13.8 13.8 0 0 1-2.2-7.4c0-1.3 0-2.7-.2-4-.5-3.1-2-4.6-4.8-4.7a5.5 5.5 0 0 0-5.7 4.6l-.2.6Z" />
            <path fill="currentColor" d="M0 69.6s14.3-7 28.7-7l10.8-33.5c.4-1.6 1.6-2.7 3-2.7 1.2 0 2.4 1.1 2.8 2.7l10.9 33.5c17 0 28.6 7 28.6 7L60.5 3.2c-.7-2-2-3.2-3.5-3.2H27.8c-1.6 0-2.7 1.3-3.4 3.2L0 69.6Z" />
            <defs>
              <linearGradient id="astro-flame-footer" x1="22.5" x2="69.1" y1="107" y2="84.9" gradientUnits="userSpaceOnUse">
                <stop stop-color="#D83333" />
                <stop offset="1" stop-color="#FF5D01" />
              </linearGradient>
            </defs>
          </svg>
          <span>Astro</span>
        </a>

        {/* React Badge */}
        <a
          href="https://react.dev"
          target="_blank"
          rel="noopener noreferrer"
          title="React — The Library for Web and Native User Interfaces"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-sky-400/50 text-slate-400 hover:text-sky-400 hover:bg-sky-400/10 transition-all text-[11px] font-semibold group focus:outline-none focus:ring-2 focus:ring-sky-400/40 shadow-sm"
        >
          <svg class="w-3.5 h-3.5 transition-transform group-hover:scale-110" viewBox="-11.5 -10.23174 23 20.46348" fill="none" aria-hidden="true">
            <circle cx="0" cy="0" r="2.05" fill="currentColor" />
            <g stroke="currentColor" stroke-width="1" fill="none">
              <ellipse rx="11" ry="4.2" />
              <ellipse rx="11" ry="4.2" transform="rotate(60)" />
              <ellipse rx="11" ry="4.2" transform="rotate(120)" />
            </g>
          </svg>
          <span>React</span>
        </a>
      </div>
    </div>
  </div>
</footer>
