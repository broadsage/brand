---
import SectionHeader from './SectionHeader.astro';
import PressBoilerplate from '../islands/PressBoilerplate';
import { Shield, Cpu, Activity, Wrench } from 'lucide-react';
---

<section id="about" class="space-y-8 scroll-mt-24">
  <SectionHeader
    title="Brand Foundation, Mission & Press Kit"
    subtitle="Official press boilerplate, naming rules, and Broadsage's architectural foundation"
    badge="Press & Mission"
  />

  {/* 1-Click Copy Press Boilerplate Studio */}
  <PressBoilerplate client:visible />

  {/* Architectural Mission & Enterprise Open Source Card */}
  <div class="glass-panel theme-card-gradient p-6 sm:p-8 rounded-2xl border border-amber-500/20 shadow-xl space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h3 class="text-lg sm:text-xl font-bold text-amber-500 dark:text-amber-400">
        Enterprise Mission &amp; Application Architecture
      </h3>
      <span class="text-xs font-mono font-bold px-2.5 py-1 rounded dark:bg-sky-950/60 bg-sky-50 dark:text-sky-400 text-sky-800 border dark:border-sky-800 border-sky-300">
        The Open-Source Way
      </span>
    </div>

    {/* Mission & Vision Side-by-Side */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl dark:bg-slate-950/60 bg-white border-l-4 border-amber-400 shadow-sm space-y-1">
        <span class="text-xs font-mono font-bold text-amber-500 dark:text-amber-400 uppercase tracking-wider block">
          Mission
        </span>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Broadsage is an enterprise open-source software company developing production-grade applications, developer platforms, and cloud infrastructure solutions. Following the enterprise open-source model, Broadsage transforms distributed open-source stacks—from agentic AI to cloud systems—into hardened, production-ready enterprise applications that empower engineering freedom without vendor lock-in.
        </p>
      </div>

      <div class="p-4 rounded-xl dark:bg-slate-950/60 bg-white border-l-4 border-sky-400 shadow-sm space-y-1">
        <span class="text-xs font-mono font-bold text-sky-500 dark:text-sky-400 uppercase tracking-wider block">
          Vision
        </span>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          <em>“Broad Vision, Sage Guidance — Open to Everyone.”</em> To be the global leader and trusted enterprise open-source software company developing sovereign applications. By uniting radical open-source transparency with calm, authoritative architectural guidance, Broadsage ensures that the future of software engineering remains open, sovereign, and accessible to all developers.
        </p>
      </div>
    </div>

    <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
      Broadsage develops enterprise software applications bridging fast-moving open-source innovation with hardened, production-grade platform engineering. Modeled on proven enterprise open-source standards, we champion developer autonomy, open governance, and application excellence across every deployment surface.
    </p>

    {/* 4 Architectural Pillars Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
      <div class="p-4 rounded-xl dark:bg-slate-900/60 bg-white border dark:border-slate-800/80 border-ivory-400 space-y-2 shadow-xs">
        <div class="flex items-center gap-2 text-amber-500 dark:text-amber-400">
          <Shield className="w-4 h-4" />
          <h4 class="text-xs font-bold dark:text-white text-navy-900">Open-Source Hardening</h4>
        </div>
        <p class="text-[11px] text-slate-400 leading-normal">
          Curating, auditing, and securing distributed open-source stacks for enterprise stability.
        </p>
      </div>

      <div class="p-4 rounded-xl dark:bg-slate-900/60 bg-white border dark:border-slate-800/80 border-ivory-400 space-y-2 shadow-xs">
        <div class="flex items-center gap-2 text-sky-500 dark:text-sky-400">
          <Cpu className="w-4 h-4" />
          <h4 class="text-xs font-bold dark:text-white text-navy-900">Autonomous Agentic Mesh</h4>
        </div>
        <p class="text-[11px] text-slate-400 leading-normal">
          Integrating AI review agents, LLM reasoning meshes, and automated developer loops into CI/CD.
        </p>
      </div>

      <div class="p-4 rounded-xl dark:bg-slate-900/60 bg-white border dark:border-slate-800/80 border-ivory-400 space-y-2 shadow-xs">
        <div class="flex items-center gap-2 text-emerald-500 dark:text-emerald-400">
          <Activity className="w-4 h-4" />
          <h4 class="text-xs font-bold dark:text-white text-navy-900">Unified Telemetry</h4>
        </div>
        <p class="text-[11px] text-slate-400 leading-normal">
          High-throughput OpenTelemetry and ClickHouse streaming metrics tracking DORA and health.
        </p>
      </div>

      <div class="p-4 rounded-xl dark:bg-slate-900/60 bg-white border dark:border-slate-800/80 border-ivory-400 space-y-2 shadow-xs">
        <div class="flex items-center gap-2 text-purple-500 dark:text-purple-400">
          <Wrench className="w-4 h-4" />
          <h4 class="text-xs font-bold dark:text-white text-navy-900">Paved Roads &amp; CLI</h4>
        </div>
        <p class="text-[11px] text-slate-400 leading-normal">
          Open-source developer CLI runtimes, standardized golden paths, and self-service environments.
        </p>
      </div>
    </div>
  </div>
</section>
