---
import PressBoilerplate from '../islands/PressBoilerplate';
import { Shield, Cpu, Activity, Wrench } from 'lucide-react';
---

<section id="about" class="space-y-8 scroll-mt-24">
  {/* Section Header */}
  <div class="flex items-end justify-between border-b dark:border-slate-800 border-[#E6DED2] pb-4 flex-wrap gap-2">
    <div>
      <h2 class="text-2xl sm:text-3xl font-extrabold dark:text-white text-[#0A1128] tracking-tight">
        Brand Foundation, Mission &amp; Press Kit
      </h2>
      <p class="text-xs sm:text-sm dark:text-slate-400 text-slate-600 mt-1">
        Official press boilerplate, naming rules, and Broadsage's architectural foundation
      </p>
    </div>
    <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-md dark:bg-slate-800 bg-[#FAF8F5] text-amber-500 dark:text-amber-400 border dark:border-slate-700 border-[#DBD1C2]">
      Press &amp; Mission
    </span>
  </div>

  {/* 1-Click Copy Press Boilerplate Studio */}
  <PressBoilerplate client:visible />

  {/* Architectural Mission & Open Enterprise Foundation Card */}
  <div class="glass-panel theme-card-gradient p-6 sm:p-8 rounded-2xl border border-amber-500/20 shadow-xl space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h3 class="text-lg sm:text-xl font-bold text-amber-500 dark:text-amber-400">
        Architectural Mission &amp; Open Enterprise Foundation
      </h3>
      <span class="text-xs font-mono font-bold px-2.5 py-1 rounded dark:bg-sky-950/60 bg-sky-50 dark:text-sky-400 text-sky-800 border dark:border-sky-800 border-sky-300">
        The Open-Source Way
      </span>
    </div>

    {/* Mission & Vision Side-by-Side */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl dark:bg-slate-950/60 bg-white border-l-4 border-amber-400 shadow-sm space-y-1">
        <span class="text-xs font-mono font-bold text-amber-500 dark:text-amber-400 uppercase tracking-wider block">
          Mission
        </span>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Broadsage champions the open-source way by building transparent, community-driven technologies and transforming distributed open-source stacks—from agentic AI to cloud infrastructure—into hardened, enterprise-grade architectures that empower engineering freedom without vendor lock-in.
        </p>
      </div>

      <div class="p-4 rounded-xl dark:bg-slate-950/60 bg-white border-l-4 border-sky-400 shadow-sm space-y-1">
        <span class="text-xs font-mono font-bold text-sky-500 dark:text-sky-400 uppercase tracking-wider block">
          Vision
        </span>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          <em>“Broad Vision, Sage Guidance — Open to Everyone.”</em> To be the global catalyst and trusted open enterprise foundation. By uniting radical open-source transparency with calm, authoritative architectural guidance, Broadsage ensures that the future of software engineering remains open, sovereign, and accessible to all developers.
        </p>
      </div>
    </div>

    <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
      Broadsage operates as the strategic architectural bridge uniting fast-moving open-source cloud and AI innovation with hardened enterprise platform engineering. We champion developer autonomy, open governance, and production excellence across every deployment surface.
    </p>

    {/* 4 Architectural Pillars Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
      <div class="p-4 rounded-xl dark:bg-slate-900/60 bg-white border dark:border-slate-800/80 border-[#DBD1C2] space-y-2 shadow-xs">
        <div class="flex items-center gap-2 text-amber-500 dark:text-amber-400">
          <Shield className="w-4 h-4" />
          <h4 class="text-xs font-bold text-white">Open-Source Hardening</h4>
        </div>
        <p class="text-[11px] text-slate-400 leading-normal">
          Curating, auditing, and securing distributed open-source stacks for enterprise stability.
        </p>
      </div>

      <div class="p-4 rounded-xl dark:bg-slate-900/60 bg-white border dark:border-slate-800/80 border-[#DBD1C2] space-y-2 shadow-xs">
        <div class="flex items-center gap-2 text-sky-500 dark:text-sky-400">
          <Cpu className="w-4 h-4" />
          <h4 class="text-xs font-bold text-white">Autonomous Agentic Mesh</h4>
        </div>
        <p class="text-[11px] text-slate-400 leading-normal">
          Integrating AI review agents, LLM reasoning meshes, and automated developer loops into CI/CD.
        </p>
      </div>

      <div class="p-4 rounded-xl dark:bg-slate-900/60 bg-white border dark:border-slate-800/80 border-[#DBD1C2] space-y-2 shadow-xs">
        <div class="flex items-center gap-2 text-emerald-500 dark:text-emerald-400">
          <Activity className="w-4 h-4" />
          <h4 class="text-xs font-bold text-white">Unified Telemetry</h4>
        </div>
        <p class="text-[11px] text-slate-400 leading-normal">
          High-throughput OpenTelemetry and ClickHouse streaming metrics tracking DORA and health.
        </p>
      </div>

      <div class="p-4 rounded-xl dark:bg-slate-900/60 bg-white border dark:border-slate-800/80 border-[#DBD1C2] space-y-2 shadow-xs">
        <div class="flex items-center gap-2 text-purple-500 dark:text-purple-400">
          <Wrench className="w-4 h-4" />
          <h4 class="text-xs font-bold text-white">Paved Roads &amp; CLI</h4>
        </div>
        <p class="text-[11px] text-slate-400 leading-normal">
          Open-source developer CLI runtimes, standardized golden paths, and self-service environments.
        </p>
      </div>
    </div>
  </div>
</section>
